{
  "compilerOptions": {
    "baseUrl": "..",
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "../.node-test-build",
    "paths": { "@/*": ["./*"] },
    "resolveJsonModule": true,
    "rootDir": "..",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020"
  },
  "include": [
    "*.test.ts",
    "fixtures/proc-sections.json",
    "../components/pre-sales/metrics.ts",
    "../components/pre-sales/outcome-utils.ts",
    "../components/pre-sales/section-assignment-utils.ts",
    "../components/finance/utils.ts",
    "../lib/password-reset-session.ts",
    "../lib/consent/**/*.ts"
  ]
}

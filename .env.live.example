# Live (production) env template for qiko.ai. This is the full checklist of vars a production
# deploy needs. Copy to `.env` ON THE LIVE BOX (or store as the SSM SecureString /qiko/live/ENV
# used only to bootstrap a fresh host), fill in the real secrets, and NEVER commit real values.
# The values below are safe placeholders/examples, not real secrets.
#
# Startup guard (app/core/config.py:assert_secrets_set): a non-dev deploy REFUSES to start unless
# SESSION_SECRET is changed from the default and USE_DB_STORES=true and TASK_BACKEND=arq.

ENVIRONMENT=live
LOG_LEVEL=WARNING

# --- Postgres (with pgvector) ---------------------------------------------------------------
POSTGRES_USER=qiko
POSTGRES_PASSWORD=CHANGE-ME-strong-random          # REQUIRED. Generate: openssl rand -base64 32
POSTGRES_DB=qiko
# Must match POSTGRES_* above. Host is the compose service name `db` (private app-net).
DATABASE_URL=

# --- Redis + async workers + persistence toggles --------------------------------------------
REDIS_URL=redis://redis:6379/0
TASK_BACKEND=arq            # MUST be arq in production (out-of-band worker tier)
USE_DB_STORES=true          # MUST be true in production (persist to Postgres)

# --- Auth / sessions / encryption -----------------------------------------------------------
SESSION_SECRET=CHANGE-ME-strong-random             # REQUIRED. Generate: openssl rand -hex 32
# Dedicated key for encryption-at-rest (channel tokens, Vapi/Salesforce secrets). Kept SEPARATE
# from SESSION_SECRET so the two rotate independently. Generate: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE-ME-strong-random
CONSENT_PSEUDONYM_KEYS={"v1":"CHANGE-ME-AT-LEAST-32-RANDOM-CHARACTERS"}
CONSENT_PSEUDONYM_ACTIVE_VERSION=v1
FORWARDED_ALLOW_IPS=172.28.20.2
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Public URLs / cookies / CORS -----------------------------------------------------------
# Baked into the frontend build (docker-compose build arg for creator + admin). Same origin as
# the creator app so cookies stay first-party; Caddy proxies /api/* to qiko-core.
PUBLIC_API_BASE=https://qiko.ai/api/v1
PUBLIC_BASE_URL=https://qiko.ai
# Enterprise launch: public/embed chat is intentionally disabled.
PUBLIC_CHAT_ENABLED=false
# Keep live auth cookies host-only so they cannot collide with preprod or reach unrelated subdomains.
COOKIE_DOMAIN=
LEGACY_COOKIE_DOMAIN=.qiko.ai
# NOTE: CORS_ALLOW_ORIGINS is a list -> it MUST be a JSON array (a bare/comma string will fail to
# parse and the app will refuse to start). Include both first-party origins.
CORS_ALLOW_ORIGINS=["https://qiko.ai","https://admin.qiko.ai"]
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=10485760

# --- AI gateway (ADR-007/008/009). Bedrock is the default path. -----------------------------
AI_PROVIDER=bedrock
AI_FALLBACK_PROVIDER=stub
AWS_REGION=eu-central-1
BEDROCK_MODEL=anthropic.claude-sonnet-4-5
BEDROCK_INFERENCE_PROFILE=eu
EMBEDDINGS_PROVIDER=titan     # titan (Bedrock Titan V2) in production; local is a dev fallback
EMBEDDINGS_DIM=1024
VOICE_MODEL=amazon.nova-sonic-v1:0
# Bedrock auth comes from the EC2 instance role (preferred) or explicit AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY if the box has no suitable role. Do not commit real keys.

# --- Email (smtp in production) -------------------------------------------------------------
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USER=CHANGE-ME
SMTP_PASSWORD=CHANGE-ME
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM=REPLACE_WITH_EMAIL_FROM

# --- Integrations (optional; set only those in use. Real values via SSM, never committed) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
SLACK_SCOPES=chat:write,channels:read,im:history,commands
CLICKUP_API_TOKEN=
CALENDLY_TOKEN=
SIGNAL_ENGINE_URL=
SIGNAL_ENGINE_API_KEY=
GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=
# Salesforce OAuth (authorization_code + PKCE); set only if the Salesforce integration is live.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=

# --- Observability (exporters off unless configured) ----------------------------------------
SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=

{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
		trusted_proxies_strict
	}
}

# Live (production) reverse proxy + automatic TLS (Let's Encrypt).
# Creator + API share one origin (cookies stay first-party); admin on its own subdomain.
# Mounted into the caddy service by docker-compose.live.yml. Mirrors the preprod Caddyfile,
# differing only by the public domains (qiko.ai / admin.qiko.ai instead of *.preprod.qiko.ai).
# Caddy issues a certificate for both names and redirects www to the canonical qiko.ai origin.
# This keeps API, auth, CSRF and consent requests same-origin without expanding CORS policy.
qiko.ai, www.qiko.ai {
	@www host www.qiko.ai
	redir @www https://qiko.ai{uri} permanent
	request_body {
		max_size 10MB
	}
	# The public embed surface (/embed/*, /widget.js) is a chat widget meant to be framed by any
	# external site, so it uses frame-ancestors * and no X-Frame-Options. Everything else stays
	# clickjacking-locked (SAMEORIGIN + frame-ancestors 'self'). QIK-336.
	@embed path /embed/* /widget.js
	# Marketing site v2 (qiko-website-v2): shared nav/footer across Home, Signal and Labs.
	# Only these specific paths move; everything else (login, dashboard, api, embed) stays on
	# the existing creator/qiko-core origin, unchanged. Same pattern as /api/* and /embed/*
	# below, just a different backend. Isolated container on this stack's proxy network.
	# /mkt-static/* is this app's Next.js assetPrefix (next.config.ts), so its /_next/static/*
	# JS/CSS don't collide with creator's own /_next/static/* on this shared domain (Next.js
	# "Multi Zones" pattern). /assets/* is its public/ folder (logo etc), not covered by
	# assetPrefix, and not a path creator uses. Both must route here too, or the marketing pages
	# render with no styles/logo, this broke on the first live cutover attempt (QIKO-1074).
	# /signal, /signal/guest-audit, /signal/sample-report are this app's own unified-nav versions
	# of Signal's marketing pages. The "signal-proxy" Cloudflare Worker (bound to qiko.ai/signal*
	# ahead of this origin) forwards everything under /signal/* to signal-origin.qiko.ai (the
	# real Signal app: login, dashboard, api, register etc) EXCEPT these exact three paths,
	# which it explicitly lets fall through to this origin instead. Both sides must agree on the
	# same three paths or one side 404s/misroutes; update the Worker if this list changes.
	@marketing path / /labs /about /terms /privacy /cookies /assets/* /mkt-static/* /signal /signal/guest-audit /signal/sample-report
	@app {
		not path /embed/* /widget.js
	}
	header @app {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://qiko.ai https://*.stripe.com; font-src 'self' data:; connect-src 'self' https://api.stripe.com; frame-src 'self' https://js.stripe.com; worker-src 'self' blob:"
	}
	header @embed {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors *; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:"
	}
	handle /embed/* {
		reverse_proxy creator:3000
	}
	handle /widget.js {
		reverse_proxy creator:3000
	}
	handle /api/* {
		reverse_proxy qiko-core:8000
	}
	handle @marketing {
		reverse_proxy website:3000
	}
	handle {
		reverse_proxy creator:3000
	}
}

admin.qiko.ai {
	request_body {
		max_size 10MB
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://qiko.ai; font-src 'self' data:; connect-src 'self'"
	}
	handle /api/* {
		reverse_proxy qiko-core:8000
	}
	handle {
		reverse_proxy admin:3001
	}
}

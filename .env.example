# Copy to .env for local dev. Real secrets live in AWS SSM per environment, never in git.
# Empty values fall back to safe dev defaults / stub gateways.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Postgres (with pgvector)
POSTGRES_USER=qiko
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=qiko
DATABASE_URL=postgresql+asyncpg://qiko:change-me-locally@db:5432/qiko

# Redis + async workers + persistence toggles
REDIS_URL=redis://redis:6379/0
TASK_BACKEND=eager          # eager (dev) | arq (prod worker tier)
USE_DB_STORES=false         # true -> live app persists to Postgres

# AI gateway (ADR-007/008/009). Bedrock is the default path.
AI_PROVIDER=bedrock
AI_FALLBACK_PROVIDER=stub
AWS_REGION=eu-central-1
BEDROCK_MODEL=anthropic.claude-sonnet-4-5
BEDROCK_INFERENCE_PROFILE=eu
EMBEDDINGS_PROVIDER=local    # local (dev) | titan (Bedrock Titan V2)
EMBEDDINGS_DIM=1024
VOICE_MODEL=amazon.nova-sonic-v1:0

# Auth / sessions
SESSION_SECRET=change-me-locally
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# API hardening
CORS_ALLOW_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Email (console in dev; smtp in prod)
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@qiko.ai

# Integrations (secret NAMES documented; real values via SSM, never committed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
CLICKUP_API_TOKEN=
CALENDLY_TOKEN=
SIGNAL_ENGINE_URL=
SIGNAL_ENGINE_API_KEY=
GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=

# Observability (exporters off unless configured)
SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=

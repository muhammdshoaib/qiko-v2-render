# Copy to .env for local dev. Real secrets live in AWS SSM per environment, never in git.
# Empty values fall back to safe dev defaults / stub gateways.
ENVIRONMENT=dev
LOG_LEVEL=DEBUG
QIKO_DEV_HTTP_PORT=8080
QIKO_DEV_API_PORT=8000
QIKO_DEV_CREATOR_PORT=3000
QIKO_DEV_ADMIN_PORT=3001

# Postgres (with pgvector)
POSTGRES_USER=qiko
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=qiko
DATABASE_URL=

# Redis + async workers + persistence toggles
REDIS_URL=redis://redis:6379/0
TASK_BACKEND=arq
USE_DB_STORES=true

# AI gateway (ADR-007/008/009). Local uses stub; deployment uses Bedrock.
AI_PROVIDER=stub
AI_FALLBACK_PROVIDER=stub
AWS_REGION=eu-central-1
BEDROCK_MODEL=anthropic.claude-sonnet-4-5
BEDROCK_INFERENCE_PROFILE=eu
EMBEDDINGS_PROVIDER=local    # local (dev) | titan (Bedrock Titan V2)
EMBEDDINGS_DIM=1024
VOICE_MODEL=amazon.nova-sonic-v1:0

# Auth / sessions
SESSION_SECRET=change-me-locally
CONSENT_PSEUDONYM_KEYS={"v1":"CHANGE-ME-AT-LEAST-32-RANDOM-CHARACTERS"}
CONSENT_PSEUDONYM_ACTIVE_VERSION=v1
FORWARDED_ALLOW_IPS=172.28.30.2
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# API hardening
# Qiko-operated origins ONLY. This list grants two powers: browsers there may read our responses,
# and require_csrf accepts them as the Origin of a cookie-authenticated mutation. Never add a
# third party here to clear a CORS error; use PARTNER_CORS_ORIGINS below.
CORS_ALLOW_ORIGINS=["http://qiko.localhost:8080","http://admin.qiko.localhost:8080"]
# Third-party origins that may read responses in a browser and are NOT CSRF-trusted. Same JSON
# array format. Leave empty unless an integrator's browser app genuinely needs to call us: a
# service API key belongs in their backend, and that path needs no CORS entry at all.
PARTNER_CORS_ORIGINS=[]
PUBLIC_BASE_URL=http://qiko.localhost:8080
CREATOR_PUBLIC_BASE=http://qiko.localhost:8080
ADMIN_PUBLIC_BASE=http://admin.qiko.localhost:8080
PUBLIC_API_BASE=/api/v1
ADMIN_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_CREATOR_BASE_URL=http://qiko.localhost:8080
# Enterprise deployments should keep public/embed chat off unless explicitly approved.
PUBLIC_CHAT_ENABLED=false
# Set when creator/admin live on different subdomains of the same site (e.g. ".preprod.qiko.ai")
# so the auth/CSRF cookies are visible to both. Leave empty for host-only cookies (single host).
COOKIE_DOMAIN=.qiko.localhost
LEGACY_COOKIE_DOMAIN=
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=10485760

# Email (console in dev; smtp in prod)
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM=REPLACE_WITH_EMAIL_FROM

# Integrations (secret NAMES documented; real values via SSM, never committed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
INTERAKT_WEBHOOK_SECRET=
INTERAKT_API_KEY=
JM_BACKEND_BASE_URL=
JM_BACKEND_SHARED_SECRET=
JM_BACKEND_API_KEY=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=          # verifies every inbound Events API request; required to enable capture
SLACK_REDIRECT_URI=
# Public channel history only. Do NOT add groups:history or im:history: the assistant drops
# anything that is not a public channel, so those scopes would grant unused access to private
# channels and DMs.
SLACK_SCOPES=channels:history,channels:read,app_mentions:read,chat:write
SLACK_DIGEST_INTERVAL_MINUTES=60
SLACK_MESSAGE_RETENTION_DAYS=7
SIGNAL_ENGINE_URL=
SIGNAL_ENGINE_API_KEY=
GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=

# Qiko Track service token for one-click auto-connect. Leave empty to keep the manual token form.
QIKO_TRACK_SERVICE_TOKEN=

# GitHub App for Intelligence Worker (read-only). App slug is for the install redirect; private key
# is the PEM downloaded from the GitHub App settings. Leave empty to use a PAT pasted per worker.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=

# Observability (exporters off unless configured)
SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=

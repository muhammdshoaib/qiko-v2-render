# Preprod reverse proxy + automatic TLS (Let's Encrypt).
# Creator + API share one origin (cookies stay first-party); admin on its own subdomain.
preprod.qiko.ai {
	request_body {
		max_size 10MB
	}
	# The public embed surface (/embed/*, /widget.js) is a chat widget meant to be framed by any
	# external site, so it uses frame-ancestors * and no X-Frame-Options. Everything else stays
	# clickjacking-locked (SAMEORIGIN + frame-ancestors 'self'). QIK-336.
	@embed path /embed/* /widget.js
	@marketing path / /labs /about /terms /privacy /cookies /signal /signal/guest-audit /signal/sample-report /signal/terms /signal/privacy /visibility /communication /transaction /agents /hotels /subscriptions /status /contact /robots.txt /sitemap.xml /assets/* /qiko-static/* /mkt-static/* /api/labs/contact /api/calendly/availability /api/calendly/book /api/signal/guest-audit /api/signal/guest-audit/status /api/signal/waitlist /api/contact
	@core_api {
		path /api/*
		not path /api/labs/contact /api/calendly/availability /api/calendly/book /api/signal/guest-audit /api/signal/guest-audit/status /api/signal/waitlist /api/contact
	}
	@app {
		not path /embed/* /widget.js
	}
	header @app {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://qiko.ai https://*.stripe.com; font-src 'self' data:; connect-src 'self' https://api.stripe.com; frame-src 'self' https://js.stripe.com; worker-src 'self' blob:"
	}
	header @embed {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors *; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:"
	}
	handle /embed/* {
		reverse_proxy creator:3000
	}
	handle /widget.js {
		reverse_proxy creator:3000
	}
	handle @marketing {
		reverse_proxy website:3000
	}
	handle @core_api {
		reverse_proxy qiko-core:8000
	}
	handle {
		reverse_proxy creator:3000
	}
}

admin.preprod.qiko.ai {
	request_body {
		max_size 10MB
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://qiko.ai; font-src 'self' data:; connect-src 'self'"
	}
	handle /api/* {
		reverse_proxy qiko-core:8000
	}
	handle {
		reverse_proxy admin:3001
	}
}

# Marketing site v2 (qiko-website-v2) -- shared nav/footer across Home, Signal, Labs.
# Isolated container on the same proxy network; does not touch the app/admin blocks above.
# On live, the equivalent marketing paths are served under the qiko.ai app vhost's own @app
# header block (see Caddyfile.live's @marketing handle), so they already inherit
# X-Frame-Options/Permissions-Policy from there. This is a standalone vhost on preprod, so it
# needs its own copy of those headers to match -- an external scan flagged this exact gap.
www.preprod.qiko.ai {
	request_body {
		max_size 10MB
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}
	handle {
		reverse_proxy website:3000
	}
}

# Signal preprod (qiko-signal-preprod stack) -- own DB/Redis/13 services on this host, this
# vhost is the only thing shared with the platform stack (the frontend container's alias on
# the shared proxy network). Does not touch the blocks above.
#
# WEB-1015: the old qiko-signal marketing surface is retired. Public pages are owned by the
# website (www.preprod.qiko.ai), so the marketing paths on this host redirect there and only
# the app itself (/login, /register, /dashboard, /api, assets) still proxies to Signal.
signal.preprod.qiko.ai {
	request_body {
		max_size 10MB
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
	@home path /
	redir @home https://www.preprod.qiko.ai/signal permanent
	@guest_audit path /guest-audit /guest-audit/*
	redir @guest_audit https://www.preprod.qiko.ai/signal/guest-audit permanent
	@sample_report path /sample-report /sample-report/*
	redir @sample_report https://www.preprod.qiko.ai/signal/sample-report permanent
	@legal_terms path /terms /terms/*
	redir @legal_terms https://www.preprod.qiko.ai/signal/terms permanent
	@legal_privacy path /privacy /privacy/*
	redir @legal_privacy https://www.preprod.qiko.ai/signal/privacy permanent
	@legal_cookies path /cookies /cookies/*
	redir @legal_cookies https://www.preprod.qiko.ai/cookies permanent
	@status_page path /system /system/*
	redir @status_page https://www.preprod.qiko.ai/status permanent
	@retired_marketing path /pricing /pricing/* /features /blog /blog/* /about /about/* /faq /docs /docs/* /case-studies /case-studies/* /contact /contact/* /volatility /feed.xml /sitemap.xml /robots.txt
	redir @retired_marketing https://www.preprod.qiko.ai/signal permanent
	handle {
		reverse_proxy signal-frontend:3000 {
			lb_try_duration 45s
			lb_try_interval 500ms
		}
	}
}

		client_ip_headers CF-Connecting-IP X-Forwarded-For
		trusted_proxies_strict
	}
}

# Preprod reverse proxy + automatic TLS (Let's Encrypt).
# Creator + API share one origin (cookies stay first-party); admin on its own subdomain.
preprod.qiko.ai {
	request_body {
		max_size 10MB
	}
	# The public embed surface (/embed/*, /widget.js) is a chat widget meant to be framed by any
	# external site, so it uses frame-ancestors * and no X-Frame-Options. Everything else stays
	# clickjacking-locked (SAMEORIGIN + frame-ancestors 'self'). QIK-336.
	@embed path /embed/* /widget.js
	@app {
		not path /embed/* /widget.js
	}
	header @app {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://qiko.ai https://*.stripe.com; font-src 'self' data:; connect-src 'self' https://api.stripe.com; frame-src 'self' https://js.stripe.com; worker-src 'self' blob:"
	}
	header @embed {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors *; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:"
	}
	handle /embed/* {
		reverse_proxy creator:3000
	}
	handle /widget.js {
		reverse_proxy creator:3000
	}
	handle /api/* {
		reverse_proxy qiko-core:8000
	}
	handle {
		reverse_proxy creator:3000
	}
}

admin.preprod.qiko.ai {
	request_body {
		max_size 10MB
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://qiko.ai; font-src 'self' data:; connect-src 'self'"
	}
	handle /api/* {
		reverse_proxy qiko-core:8000
	}
	handle {
		reverse_proxy admin:3001
	}
}

# Marketing site v2 (qiko-website-v2) -- shared nav/footer across Home, Signal, Labs.
# Isolated container on the same proxy network; does not touch the app/admin blocks above.
# On live, the equivalent marketing paths are served under the qiko.ai app vhost's own @app
# header block (see Caddyfile.live's @marketing handle), so they already inherit
# X-Frame-Options/Permissions-Policy from there. This is a standalone vhost on preprod, so it
# needs its own copy of those headers to match -- an external scan flagged this exact gap.
www.preprod.qiko.ai {
	request_body {
		max_size 10MB
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}
	handle {
		reverse_proxy website:3000
	}
}

# Signal preprod (qiko-signal-preprod stack) -- own DB/Redis/13 services on this host, this
# vhost is the only thing shared with the platform stack (the frontend container's alias on
# the shared proxy network). Does not touch the blocks above.
signal.preprod.qiko.ai {
	request_body {
		max_size 10MB
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
	handle {
		reverse_proxy signal-frontend:3000 {
			lb_try_duration 45s
			lb_try_interval 500ms
		}
	}
}
